{
  "name": "campaign-cotn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run validate && vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "check": "npm run validate && svelte-check --tsconfig ./tsconfig.json",
    "validate": "node scripts/montar.ts",
    "test": "node --test 'scripts/lib/*.test.ts' 'src/**/*.test.ts'",
    "validate:avisos": "node scripts/montar.ts --warn",
    "grelha": "node scripts/grelha.ts",
    "normalizar": "python3 scripts/normalizar-texto.py",
    "gravar": "bash scripts/gravar.sh",
    "copia-drive": "python3 scripts/copia-drive.py",
    "escuta": "bash scripts/escuta.sh"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "marked": "^18.0.14",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
